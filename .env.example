# Copiez ce fichier en .env (jamais commité) et renseignez vos valeurs.

# Adresse publique du site, utilisée dans les liens des e-mails.
APP_URL=http://127.0.0.1:5173

# Envoi des e-mails (mot de passe oublié, invitations, partages, réservations, rappels).
# Sans SMTP_HOST, les e-mails sont déposés dans back/database/data/outbox/ au lieu d’être envoyés.
SMTP_HOST=smtp.exemple.fr
SMTP_PORT=587
# true pour le port 465 (TLS direct), false pour 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Anivaya <no-reply@votre-domaine.fr>

# Derrière un proxy inverse (nginx, Caddy…) qui ajoute X-Forwarded-For : mettre 1 pour que
# les limites de tentatives comptent par visiteur et non pour l’adresse du proxy.
# À laisser vide si l’API est exposée directement : l’en-tête serait falsifiable.
TRUST_PROXY=

# Import de documents par IA (via OpenRouter). Sans clé, l’import affiche un message de configuration.
# Clé : https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Modèle lisant les images. Gratuit en développement ou avec ANIVAYA_TESTING_PREVIEW=1 :
# uniquement des documents fictifs (le fournisseur peut les conserver).
# Hors version de test, NODE_ENV=production exige un modèle explicite sans suffixe :free.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Lecture des PDF : cloudflare-ai (gratuit, PDF contenant du texte), mistral-ocr (payant, PDF scannés),
# native (le modèle lit le fichier lui-même, ex. Claude).
OPENROUTER_PDF_ENGINE=cloudflare-ai

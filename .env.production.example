# Copy to .env.production on the server. Never commit actual credentials.
APP_URL=https://anivaya.com
PUBLIC_SITE_URL=https://anivaya.com
ALLOWED_ORIGINS=https://anivaya.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key in a separate secure backup; changing it breaks existing MFA secrets.
MFA_ENCRYPTION_KEY=
# Optional: AI disabled until both are explicitly configured.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PDF_ENGINE=native

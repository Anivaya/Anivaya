{
  "name": "anivaya",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node back/api/server.ts",
    "build:vercel": "npm run build && node scripts/vercel-output.ts",
    "test:cloud": "node scripts/test-cloud.ts",
    "test:production": "node scripts/production-smoke.ts",
    "admin:grant": "node scripts/admin.ts",
    "dev": "node scripts/dev.ts",
    "dev:empty": "node scripts/dev.ts --empty",
    "dev:api": "node --watch back/api/server.ts",
    "dev:front": "npm --prefix front run dev",
    "build": "npm run typecheck && npm --prefix front run build",
    "lint": "npm --prefix front run lint",
    "test": "node scripts/test-local.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p front/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}

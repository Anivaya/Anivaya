# Render backend. Copy to an ignored .env.cloud.local for local administration.
NODE_ENV=production
HOST=0.0.0.0
DATABASE_URL=
DATABASE_SCHEMA=anivaya
# TLS certificate verification stays ON; no sslmode query parameter in DATABASE_URL.
# Optional Render secret-file path if your database uses a private CA:
# DATABASE_CA_PATH=/etc/secrets/supabase-ca.crt
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=anivaya-private
APP_URL=https://anivaya.com
PUBLIC_SITE_URL=https://anivaya.com
ALLOWED_ORIGINS=https://anivaya.com
MFA_ENCRYPTION_KEY=
API_PROXY_SECRET=
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
# Single-line JSON matching deploy/legal.example.json, completed and reviewed.
LEGAL_CONTENT_JSON=
REMINDERS_MODE=external
CRON_SECRET=
# Vercel ONLY: backend origin + same API_PROXY_SECRET. Never VITE_* secrets.
RENDER_API_URL=
